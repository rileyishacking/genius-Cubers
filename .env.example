# إعدادات Supabase. انسخ هذا الملف إلى .env وضع قيم مشروعك.
# المفتاح هنا قابل للنشر (publishable) ويصل المتصفح بطبيعته،
# وحمايته تأتي من سياسات RLS لا من إخفائه.
# لا تضع هنا مفتاح service_role أبداً: هو يتجاوز RLS بالكامل.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
